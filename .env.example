# ===== Rekapin =====
# Salin ke .env lalu isi nilainya. Jangan commit .env ke git!

# Database (Vercel Postgres / Supabase Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Telegram bot token dari @BotFather
TELEGRAM_BOT_TOKEN="123456:ABC-DEF"

# URL publik aplikasi (untuk webhook Telegram), contoh: https://rekapin.vercel.app
WEBHOOK_URL="https://your-app.vercel.app"

# NextAuth: secret random, generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Email akun admin dashboard (dibuat otomatis saat setup)
ADMIN_EMAIL="admin@example.com"
# Password akun admin dashboard (min 8 karakter)
ADMIN_PASSWORD="change-me-strong"
